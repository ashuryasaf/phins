@startuml phins_context
skinparam monochrome false
skinparam shadowing false
skinparam componentStyle rectangle
skinparam wrapWidth 220

title PHINS - System Context (Suppliers + Wallets + Actuary + AI/BI)

actor Client
actor Admin
actor SupplierUser as Supplier
actor Courier
actor "External Payment Processor" as PSP
actor "Bank / ACH" as Bank
actor "Broker/Exchange" as Broker
actor "Advisor (Doctor/Lawyer)" as Advisor

rectangle "PHINS Platform" {
  [Client Portal UI] as ClientPortal
  [Supplier Portal UI] as SupplierPortal
  [Admin Portal UI] as AdminPortal
  [Actuary UI] as ActuaryUI

  [Marketplace API] as Marketplace
  [Wallet/Ledger API] as Wallet
  [Underwriting/Policy API] as Insurance
  [Claims API] as Claims
  [Billing/Invoices API] as Billing
  [Delivery API] as Delivery
  [Investment API] as Investment
  [Banking/Custody API] as Banking
  [Decisioning (Actuary/AI)] as Decisioning

  [Event Bus] as Bus
  [OLTP DB] as OLTP
  [Lakehouse/BI] as Lake
}

Client --> ClientPortal
Admin --> AdminPortal
Supplier --> SupplierPortal

ClientPortal --> Marketplace
ClientPortal --> Wallet
ClientPortal --> Insurance
ClientPortal --> Claims
ClientPortal --> Billing
ClientPortal --> Delivery
ClientPortal --> Investment
ClientPortal --> Banking

ActuaryUI --> Decisioning
AdminPortal --> Decisioning
AdminPortal --> Marketplace
AdminPortal --> Wallet
SupplierPortal --> Marketplace
SupplierPortal --> Delivery

PSP --> Wallet : deposits/charges (card)
Bank --> Banking : deposits/withdrawals
Banking --> Wallet : settlement/ledger postings
Courier --> Delivery : quotes/tracking
Broker --> Investment : venues/fees/execution
Advisor --> Marketplace : availability/pricing

Insurance --> Decisioning : risk factors, underwriting assessment
Decisioning --> Insurance : pricing + actuarial fee decisions
Claims --> Wallet : claim payout credits
Billing --> Wallet : reconciled payments
Marketplace --> Bus
Wallet --> Bus
Insurance --> Bus
Claims --> Bus
Delivery --> Bus
Investment --> Bus
Banking --> Bus

Bus --> Lake
Marketplace --> OLTP
Wallet --> OLTP
Insurance --> OLTP
Claims --> OLTP
Billing --> OLTP
Delivery --> OLTP
Investment --> OLTP
Banking --> OLTP
Decisioning --> OLTP : versioned rules/tables/models metadata
@enduml

