@startuml phins_domain
skinparam monochrome false
skinparam shadowing false
skinparam wrapWidth 220

title PHINS - Domain Model (Suppliers + Orders + Delivery + Wallets + Actuary + Investment/Banking)

class Customer {
  +id
  +dob
  +age
  +risk_profile_id
}

class RiskProfile {
  +id
  +factors_json
  +underwriting_assessment_version
}

class ActuarialTable {
  +id
  +table_type
  +version
  +effective_date
}

class FeeSchedule {
  +id
  +domain: {HEALTH, INVESTMENT, BANKING, ADVISORY, DELIVERY}
  +version
  +rules_json
}

class Supplier {
  +id
  +legal_name
  +status: {PENDING, APPROVED, SUSPENDED}
  +settlement_account_id
  +sla_tier
}

class ProductService {
  +id
  +category: {CONSULTATION, MEDICAL_DEVICE, DAILY_SUPPLY, PHARMACY, HOME_CARE, TRADING, CUSTODY, ADVISORY, DELIVERY}
  +name
  +attributes_json
}

class Offer {
  +id
  +supplier_id
  +product_service_id
  +base_price
  +currency
  +region
  +availability
  +last_updated_at
}

class SupplierInvitation {
  +code
  +supplier_type
  +created_by
  +max_uses
  +status
  +expires_at
}

class Quote {
  +id
  +customer_id
  +items_json
  +computed_price
  +pricing_explanation_json
  +pricing_version
  +expires_at
}

class Wallet {
  +id
  +customer_id
  +wallet_type: {HEALTH, INVESTMENT, BANKING, ADVISORY}
  +currency
}

class LedgerEntry {
  +id
  +wallet_id
  +direction: {DEBIT,CREDIT}
  +amount
  +reference_type
  +reference_id
  +posted_at
}

class WalletHold {
  +id
  +wallet_id
  +amount
  +status: {HELD,CAPTURED,RELEASED,EXPIRED}
  +idempotency_key
}

class Cart {
  +id
  +customer_id
  +items_json
}

class Order {
  +id
  +customer_id
  +status: {CREATED,PAID,CONFIRMED,FULFILLING,SHIPPED,DELIVERED,CANCELLED,REFUNDED}
  +total
}

class OrderItem {
  +id
  +order_id
  +offer_id
  +qty
  +unit_price
}

class DeliveryQuote {
  +id
  +order_id
  +courier
  +price
  +eta
}

class Settlement {
  +id
  +supplier_id
  +order_id
  +gross
  +fees
  +net
  +status: {PENDING,PAID,FAILED}
}

class NFTRecord {
  +token_id
  +owner_id
  +asset_type
  +asset_id
  +created_at
}

class BalanceSheetSnapshot {
  +snapshot_id
  +saved_at
  +total_assets
  +total_liabilities
  +retained_history = forever
}

class Trade {
  +id
  +customer_id
  +instrument
  +venue
  +qty
  +fees
  +status
}

class CustodyAccount {
  +id
  +customer_id
  +provider
  +status
}

Customer "1" -- "1" RiskProfile
ActuarialTable "1" -- "0..*" FeeSchedule : informs
Customer "1" -- "0..*" Wallet
Wallet "1" -- "0..*" LedgerEntry
Wallet "1" -- "0..*" WalletHold
Customer "1" -- "0..*" NFTRecord : immutable ownership / audit

SupplierInvitation "1" -- "0..*" Supplier : approved registration lineage
Supplier "1" -- "0..*" Offer
ProductService "1" -- "0..*" Offer
Customer "1" -- "0..*" Cart
Customer "1" -- "0..*" Order
Order "1" -- "1..*" OrderItem
OrderItem "*" --> "1" Offer
Order "1" -- "0..*" DeliveryQuote
Order "1" -- "0..1" Settlement
Order "1" -- "0..*" LedgerEntry : append-only financial history
Order "1" -- "0..*" NFTRecord : immutable transaction mirror

Quote "*" --> "1" Customer
Quote "*" --> "0..*" Offer : references inputs used

Customer "1" -- "0..*" Trade
Customer "1" -- "0..*" CustodyAccount
FeeSchedule ..> Quote : used for fees
ActuarialTable ..> Quote : used for risk/actuarial fees
LedgerEntry ..> BalanceSheetSnapshot : rolled into durable balance sheet history
@enduml

@startuml phins_sequence_health_checkout
skinparam monochrome false
skinparam shadowing false
skinparam wrapWidth 220

title Sequence - Health Wallet Purchase (Best Price) + Delivery + Ledger Integrity

actor Client
participant "Client Portal" as UI
participant "Marketplace" as M
participant "Quote & Ranking" as Q
participant "Decisioning (Actuary/AI)" as D
participant "Delivery Service" as Del
participant "Wallet/Ledger" as W
participant "Order Service" as O
participant "Billing Service" as B
participant "Supplier" as S
participant "Courier" as C

Client -> UI : Choose category (e.g., Consultation)
UI -> M : Search(category, location, constraints)
M -> Q : GetRankedOffers(request)
Q -> D : GetFeeSchedule + eligibility + risk adjustments\n(input: customer risk profile + actuarial tables versions)
D --> Q : pricing_rules + version + explanations
Q --> M : Ranked offers + computed final prices\n(least expensive first)
M --> UI : Show best price + alternates

Client -> UI : Add to cart + proceed to checkout
UI -> Del : Request delivery quotes(cart, address)
Del -> C : Quote request
C --> Del : Quote options (price/ETA)
Del --> UI : Delivery options

Client -> UI : Confirm purchase (select offer + courier)
UI -> O : CreateOrder(cart, selected_delivery)
O -> W : CreateHold(wallet=HEALTH, amount=order_total, idem_key)
W --> O : hold_id (HELD)
O -> B : CreateInvoice(order_id)
B --> O : invoice_id
O -> S : PlaceOrder(order details)
S --> O : Accept/Confirm
O -> W : CaptureHold(hold_id)  ## double-entry posting
W --> O : captured (ledger entries posted)
O -> Del : CreateShipment(order_id, courier)
Del -> C : Create shipment
C --> Del : tracking_id
Del --> UI : Tracking info
O --> UI : Order confirmed + receipt + tracking
@enduml

@startuml phins_order_state
skinparam monochrome false
skinparam shadowing false

title State Machine - Order Lifecycle (Wallet-safe)

[*] --> CREATED
CREATED --> PAID : wallet hold+capture OR card capture
PAID --> CONFIRMED : supplier accepts
CONFIRMED --> FULFILLING : picking/scheduling
FULFILLING --> SHIPPED : courier pickup/tracking
SHIPPED --> DELIVERED : proof of delivery
DELIVERED --> [*]

CREATED --> CANCELLED : user cancels (release hold)
PAID --> REFUNDED : refund (ledger reversal)
CONFIRMED --> CANCELLED : supplier cancel (release/refund)
SHIPPED --> REFUNDED : return/failed delivery (policy-based)
CANCELLED --> [*]
REFUNDED --> [*]
@enduml
