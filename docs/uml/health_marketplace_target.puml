title PHINS - Target Global Health Marketplace Context

actor Customer
actor "PHINS Admin" as Admin
actor Supplier
actor "External Supplier Network" as SupplierNetwork
actor "External Insurer / Payer" as Payer
actor "Payment Service Provider" as PSP
actor "Bank / Treasury Rail" as Bank
actor "Courier / Logistics" as Courier
actor "AI / BI Consumers" as Analytics

rectangle "PHINS Marketplace Operating Core" {
  [Customer Dashboard\nweb_portal/static/dashboard.html] as CustomerUI
  [Supplier Portal\nweb_portal/static/supplier-portal.html] as SupplierUI
  [Admin Dashboards\nadmin.html + admin-supplier-dashboard.html] as AdminUI

  [Marketplace API] as MarketplaceAPI
  [Coverage & Eligibility Service] as Eligibility
  [Wallet, Payments & Ledger Service] as Wallet
  [Claims & Payer Clearing Service] as Claims
  [Supplier Connectivity Hub] as SupplierHub
  [Settlement & Revenue Service] as Settlement
  [Integrity & Reconciliation Service] as Integrity
  [Outbox / Event Bus] as Bus
  [Operational Database] as OLTP
  [Lakehouse / Feature Store] as Lake
}

