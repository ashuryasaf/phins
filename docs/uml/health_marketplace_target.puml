  +base_price
  +coverage_eligible
}

class Quote {
  +id
  +customer_id
  +pricing_version
  +markup_amount
  +coverage_applied_amount
  +expires_at
}

class Order {
  +id
  +customer_id
  +supplier_id
  +status
  +gross_sales_amount
  +supplier_cost_amount
  +markup_amount
}

class OrderItem {
  +id
  +order_id
  +offer_id
  +qty
  +unit_price
}

class WalletAccount {
  +id
  +customer_id
  +wallet_type
  +available_balance
  +held_balance
}

class WalletHold {
  +id
  +wallet_account_id
  +order_id
  +amount
  +status
}

class PaymentIntent {
  +id
  +order_id
  +funding_strategy
  +status
  +idempotency_key
}

class LedgerEntry {
  +id
  +account_code
  +direction
  +amount
  +reference_type
  +reference_id
}

class SupplierSettlement {
  +id
  +supplier_id
  +order_id
  +gross_amount
  +net_payout
  +holdback_amount
  +status
}

class ExternalPayer {
  +id
  +payer_type
  +network_scope
}

class EligibilityCheck {
  +id
  +customer_id
  +payer_id
  +coverage_percent
  +decision
}

class PreAuthorization {
  +id
  +order_id
  +payer_id
  +status
  +approved_amount
}

class MarketplaceClaim {
  +id
  +order_id
  +payer_id
  +status
  +claimed_amount
}

class PayerReceivable {
  +id
  +claim_id
  +expected_amount
  +open_amount
  +status
}

class RemittanceAdvice {
  +id
  +payer_id
  +claim_id
  +paid_amount
  +denied_amount
}

class Refund {
  +id
  +order_id
  +funding_source
  +amount
  +status
}

class PricingExplanation {
  +id
  +quote_id
  +markup_percent
  +coverage_logic
  +model_version
}

class ReconciliationRun {
  +id
  +run_type
  +status
  +variance_amount
}

Customer "1" -- "0..*" Quote
Customer "1" -- "0..*" Order
Customer "1" -- "0..*" WalletAccount
Supplier "1" -- "0..*" SupplierConnector
Supplier "1" -- "0..*" Offer
Supplier "1" -- "0..*" SupplierSettlement
Quote "1" -- "1..*" Offer : ranked inputs
Quote "1" -- "1" PricingExplanation
Order "1" -- "1..*" OrderItem
OrderItem "*" --> "1" Offer
Order "1" -- "0..1" WalletHold
Order "1" -- "0..*" PaymentIntent
Order "1" -- "0..*" LedgerEntry
Order "1" -- "0..*" SupplierSettlement
Order "1" -- "0..1" MarketplaceClaim
Order "1" -- "0..*" Refund
WalletAccount "1" -- "0..*" WalletHold
WalletAccount "1" -- "0..*" LedgerEntry
ExternalPayer "1" -- "0..*" EligibilityCheck
ExternalPayer "1" -- "0..*" PreAuthorization
ExternalPayer "1" -- "0..*" MarketplaceClaim
MarketplaceClaim "1" -- "0..1" PayerReceivable
MarketplaceClaim "1" -- "0..*" RemittanceAdvice
RemittanceAdvice ..> LedgerEntry : clears receivable / credits wallet
ReconciliationRun ..> WalletAccount
ReconciliationRun ..> SupplierSettlement
ReconciliationRun ..> PayerReceivable
@enduml

@startuml phins_health_marketplace_sequence
skinparam monochrome false
skinparam shadowing false
skinparam wrapWidth 220

title Sequence - Coverage-aware Purchase, Supplier Settlement, and Insurer Reimbursement

actor Customer
participant "Dashboard" as UI
participant "Marketplace API" as M
participant "Eligibility Service" as E
participant "Quote / Ranking" as Q
participant "Wallet & Ledger" as W
participant "Order Orchestrator" as O
participant "Supplier Hub" as S
participant "Settlement Service" as ST
participant "Claims / Payer Clearing" as C
participant "External Insurer" as P

Customer -> UI : Search consultation / pharmacy / supplies
UI -> M : search(criteria)
M -> E : checkCoverage(customer, items)
E -> P : eligibility + pre-auth inquiry
P --> E : covered amount / rules / auth status
M -> Q : rankOffers(criteria, coverage, SLA, markup policy)
Q --> M : ranked offers + pricing explanation
M --> UI : best offer + alternates + customer payable

Customer -> UI : confirm order
UI -> O : createOrder(selected_offer)
O -> W : createPaymentIntent(order, funding_strategy)
O -> W : createHold(wallet_amount, idempotency_key)
W --> O : hold_id + pending ledger entries
O -> S : placeOrder(order)
S --> O : accepted / scheduled
O -> W : captureHold(hold_id)
W --> O : posted ledger entries\n(customer spend, supplier payable, markup revenue)
O -> ST : createSettlement(order)
ST --> O : settlement pending
O --> UI : order confirmed + receipt

alt external insurer reimbursement required
  O -> C : openMarketplaceClaim(order, payer_context)
  C -> P : submit claim packet
  P --> C : adjudication / remittance
  C -> W : post recovery credit or close receivable
  C -> ST : adjust PHINS receivable / customer refund if needed
  C --> UI : reimbursement status updated
end

ST -> S : settlement remittance / payout advice
ST --> UI : supplier payout visible in supplier portal
@enduml

@startuml phins_marketplace_account_state
skinparam monochrome false
skinparam shadowing false

title State Machine - Marketplace Financial Lifecycle

[*] --> QUOTED
QUOTED --> AUTHORIZED : wallet hold / card auth / payer pre-auth
AUTHORIZED --> CAPTURED : supplier accepts and PHINS captures funds
CAPTURED --> FULFILLED : service delivered / shipment completed
FULFILLED --> SETTLEMENT_PENDING : supplier payout calculated
SETTLEMENT_PENDING --> SETTLED : payout executed
SETTLED --> REIMBURSED : payer remittance received

AUTHORIZED --> RELEASED : customer cancel before capture
CAPTURED --> REFUND_PENDING : cancellation / failure / denial / return
REFUND_PENDING --> REFUNDED : compensating entries posted
REIMBURSED --> ADJUSTED : remittance short-pay / denial / appeal outcome

RELEASED --> [*]
REFUNDED --> [*]
ADJUSTED --> [*]
SETTLED --> [*]
@enduml
