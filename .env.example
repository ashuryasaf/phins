# =============================================================================
# PHINS Platform Environment Variables
# =============================================================================
# Copy this file to .env and fill in your secure values
# NEVER commit .env to version control!
#
# SECURITY REQUIREMENTS:
# ----------------------
# 1. All passwords must be changed from their default values
# 2. Passwords should be at least 16 characters with mixed case, numbers, symbols
# 3. Each account should have a UNIQUE password (no reuse)
# 4. Rotate passwords at least every 90 days
# 5. Never share credentials or commit them to version control
#
# To generate secure passwords, use:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#
# CREDENTIAL ROTATION (REQUIRED):
# -------------------------------
# If you have used any of the following legacy passwords, they have been
# exposed and MUST be rotated immediately:
#   - Any passwords containing 'admin123', 'PDa11wrt', 'PDu12ndr', etc.
#   - Passwords matching patterns from early development builds
#
# To rotate credentials:
#   1. Generate new secure passwords using the command above
#   2. Update this .env file with the new values
#   3. Restart all services
#   4. Verify all users can log in with new credentials
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/phins
# Or for SQLite (development only):
# SQLITE_PATH=/workspace/phins.db

# =============================================================================
# SYSTEM USER PASSWORDS
# These are for internal staff accounts (admin portal access)
# =============================================================================
PHINS_ADMIN_PASSWORD=CHANGE_ME_use_strong_password_here
PHINS_UNDERWRITER_PASSWORD=CHANGE_ME_use_strong_password_here
PHINS_CLAIMS_PASSWORD=CHANGE_ME_use_strong_password_here
PHINS_ACCOUNTANT_PASSWORD=CHANGE_ME_use_strong_password_here
PHINS_ACTUARY_PASSWORD=CHANGE_ME_use_strong_password_here
PHINS_SUPPLIER_PASSWORD=CHANGE_ME_use_strong_password_here
PHINS_MEDIA_PASSWORD=CHANGE_ME_use_strong_password_here

# =============================================================================
# NAMED USER ACCOUNT PASSWORDS
# These are for specific named user accounts
# =============================================================================
PHINS_USER_ASAF_PHINS_PASSWORD=CHANGE_ME_use_strong_password_here
PHINS_USER_ASAF_ASSURANCE_PASSWORD=CHANGE_ME_use_strong_password_here
PHINS_USER_EFRAT_PASSWORD=CHANGE_ME_use_strong_password_here
PHINS_USER_ASI_PASSWORD=CHANGE_ME_use_strong_password_here
PHINS_USER_SHOSH_PASSWORD=CHANGE_ME_use_strong_password_here

# =============================================================================
# DEFAULT PASSWORDS (for dynamic user creation)
# =============================================================================
# Used when creating new customer accounts without explicit password
PHINS_DEFAULT_CUSTOMER_PASSWORD=CHANGE_ME_use_strong_password_here

# Used for test accounts in non-production environments
PHINS_TEST_CUSTOMER_PASSWORD=CHANGE_ME_use_strong_password_here

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
# Base directory for file uploads (must exist and be writable)
PHINS_UPLOAD_DIR=/workspace/uploads

# =============================================================================
# WEBHOOK SECURITY
# =============================================================================
# Secret for signing webhook payloads
WEBHOOK_SIGNING_SECRET=CHANGE_ME_generate_with_secrets_token_hex_32

# =============================================================================
# SESSION SECURITY
# =============================================================================
# Secret key for session signing (generate with secrets.token_hex(32))
SESSION_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32

# =============================================================================
# EXTERNAL SERVICES (if applicable)
# =============================================================================
# Video generation providers (for /video-agents.html)
# Kling supports either a single API key OR Access/Secret key pair:
#   Option A: KLING_API_KEY=<bearer token>
#   Option B: KLING_ACCESS_KEY=<access-key> and KLING_SECRET_KEY=<secret-key>
GEMINI_API_KEY=
PHINS_GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE_URL=https://api.klingapi.com
# Optional: set KLING_API_PROFILE=evolink-v3 to route all Kling calls through
# EvoLink's unified async API (POST /v1/videos/generations + GET /v1/tasks/{id})
# with the kling-v3-* / kling-o1 / kling-o3 model family. When the requested
# model name starts with kling-v3, kling-o1, or kling-o3 the profile is also
# auto-detected, so KLING_API_PROFILE only needs to be set when overriding the
# default base URL via env vars.
# KLING_API_PROFILE=evolink-v3
# Tune the spacing between sequential video-generation submissions (seconds).
# Higher values reduce the chance of provider HTTP 400/429 cascades during
# large batch runs at the cost of a slower drain. Default 1.5s.
# PHINS_MEDIA_VIDEO_SUBMIT_SPACING_SECONDS=1.5

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# =============================================================================
# NOTIFICATION SERVICE CONFIGURATION
# =============================================================================
# Email Provider (smtp, sendgrid, ses, mailgun, resend, active_notifications)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@phins.ai
EMAIL_FROM_NAME=PHINS Insurance
EMAIL_REPLY_TO=support@phins.ai

# SendGrid (if using sendgrid provider)
SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

# AWS SES (if using ses provider)
AWS_SES_REGION=us-east-1
# AWS_SES_FROM_EMAIL=

# Mailgun (if using mailgun provider)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# MAILGUN_FROM_EMAIL=

# Resend (if using resend provider)
RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Active Notifications / Pingram / NotificationAPI (if using active_notifications provider)
ACTIVE_NOTIFICATIONS_CUSTOMER_ID=
ACTIVE_NOTIFICATIONS_API_KEY=
ACTIVE_NOTIFICATIONS_BASE_URL=https://api.pingram.io
ACTIVE_NOTIFICATIONS_SEND_PATH=/sender
ACTIVE_NOTIFICATIONS_NOTIFICATION_TYPE=phins_transactional_email
# Optional auth/header overrides if your environment uses a different contract
# ACTIVE_NOTIFICATIONS_AUTH_HEADER=Authorization
# ACTIVE_NOTIFICATIONS_AUTH_SCHEME=Bearer
# ACTIVE_NOTIFICATIONS_CLIENT_ID_HEADER=
# ACTIVE_NOTIFICATIONS_FROM_EMAIL=
# ACTIVE_NOTIFICATIONS_FROM_NAME=

# SMS Provider (twilio, sns, vonage, messagebird, telesign)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AWS SNS (if using sns provider)
AWS_SNS_REGION=us-east-1

# Vonage (if using vonage provider)
VONAGE_API_KEY=
VONAGE_API_SECRET=

# MessageBird (if using messagebird provider)
MESSAGEBIRD_API_KEY=

# Telesign (if using telesign provider).
# Get credentials at https://my.telesign.com → Settings → API authentication.
# To enable: set SMS_PROVIDER=telesign and fill in the customer ID + API key.
TELESIGN_CUSTOMER_ID=
TELESIGN_API_KEY=
# Optional overrides (defaults shown):
# TELESIGN_BASE_URL=https://rest-api.telesign.com
# TELESIGN_SEND_PATH=/v1/messaging
# TELESIGN_MESSAGE_TYPE=OTP   # one of: OTP, ARN, MKT
# TELESIGN_SENDER_ID=         # alphanumeric sender ID (must be pre-approved by Telesign)

# =============================================================================
# OTP CONFIGURATION
# =============================================================================
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_USE_ALPHANUMERIC=false

# Development aid: returns the live OTP in the API response as `demo_otp_code`.
# NEVER enable in production — it hands out password-reset codes for any account
# that can be named. It is ignored outright when the runtime is production.
PHINS_EXPOSE_DEMO_OTP=false

# =============================================================================
# CONFIDENTIAL DOCUMENT ACCESS
# =============================================================================
# Gates /internal/ (investor business plans), /legal/ (cap table, term sheet,
# agreements) and /api/legal-docs/*. Required in production, otherwise those
# paths return 503 instead of being served anonymously.
# Generate with: openssl rand -hex 32
PHINS_CONFIDENTIAL_ACCESS_TOKEN=
# PHINS_CONFIDENTIAL_DOCS_PUBLIC=false
# PHINS_CONFIDENTIAL_PATHS=
# PHINS_CONFIDENTIAL_COOKIE_MAX_AGE=43200

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
OTP_RATE_LIMIT_PER_MINUTE=3
OTP_RATE_LIMIT_PER_HOUR=10
OTP_RATE_LIMIT_PER_DAY=20
EMAIL_RATE_LIMIT_PER_MINUTE=10
EMAIL_RATE_LIMIT_PER_HOUR=50
EMAIL_RATE_LIMIT_PER_DAY=200
SMS_RATE_LIMIT_PER_MINUTE=5
SMS_RATE_LIMIT_PER_HOUR=20
SMS_RATE_LIMIT_PER_DAY=50
IP_RATE_LIMIT_PER_MINUTE=30
IP_RATE_LIMIT_PER_HOUR=200
RATE_LIMIT_BLOCK_DURATION_MINUTES=30

# =============================================================================
# NOTIFICATION QUEUE
# =============================================================================
NOTIFICATION_QUEUE_ENABLED=true
NOTIFICATION_QUEUE_MAX_RETRIES=3
NOTIFICATION_QUEUE_RETRY_DELAY_SECONDS=60
NOTIFICATION_QUEUE_WORKER_THREADS=5

# =============================================================================
# NOTIFICATION SECURITY
# =============================================================================
# Secret for signing notification payloads (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
NOTIFICATION_SIGNING_SECRET=CHANGE_ME_generate_with_secrets_token_hex_32

# Encryption key for sensitive content (Fernet key)
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHINS_ENCRYPTION_KEY=

# =============================================================================
# NOTIFICATION AUDIT
# =============================================================================
NOTIFICATION_AUDIT_ENABLED=true
NOTIFICATION_AUDIT_RETENTION_DAYS=365

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Set to 'production' in production environments
ENVIRONMENT=development
DEBUG=false

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
# LOG_FILE=/var/log/phins/app.log
