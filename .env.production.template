# ============================================================================
# PHINS Production Environment Template
# ============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control - it contains secrets!
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PHINS_ENV=production
PORT=5000

# ============================================================================
# DATABASE (REQUIRED)
# ============================================================================
USE_DATABASE=1
# For SQLite (development only):
# USE_SQLITE=1

# For PostgreSQL (production):
DATABASE_URL=postgresql://username:password@host:5432/phins

# ============================================================================
# SECURITY KEYS (REQUIRED)
# ============================================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<your-64-character-secret-key>

# For actuarial table encryption
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
VAULT_KEY=<your-32-character-vault-key>

# For general data encryption (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHINS_ENCRYPTION_KEY=<your-fernet-key>
NOTIFICATION_SIGNING_SECRET=<your-signing-secret>

# ============================================================================
# CONFIDENTIAL DOCUMENT ACCESS (REQUIRED to serve /internal/ and /legal/)
# ============================================================================
# Gates the investor business plans (/internal/) and corporate instruments
# (/legal/: cap table, term sheet, shareholders/employment agreements) plus the
# /api/legal-docs/* signature endpoints. Without this token those paths return
# 503 in production instead of being served anonymously.
# Generate with: openssl rand -hex 32
PHINS_CONFIDENTIAL_ACCESS_TOKEN=
# Share a document as: https://<host>/internal/<doc>.html?access_token=<token>
# The token is exchanged for an HttpOnly cookie and stripped from the URL.
#
# Set to true ONLY to deliberately publish those documents to anyone:
# PHINS_CONFIDENTIAL_DOCS_PUBLIC=false
# Extra paths to gate (entries ending in '/' are prefixes):
# PHINS_CONFIDENTIAL_PATHS=

# ============================================================================
# VIDEO GENERATION PROVIDERS (OPTIONAL)
# For /video-agents.html and admin media generation
# ============================================================================
# Gemini / Veo:
GEMINI_API_KEY=
PHINS_GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
#
# Kling: set either KLING_API_KEY OR KLING_ACCESS_KEY + KLING_SECRET_KEY
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE_URL=https://api.klingapi.com

# ============================================================================
# EMAIL SERVICE (CHOOSE ONE PROVIDER)
# ============================================================================
EMAIL_PROVIDER=smtp  # Options: smtp, sendgrid, ses, mailgun, resend, active_notifications, infobip
EMAIL_FROM_ADDRESS=noreply@phins.ai
EMAIL_FROM_NAME=PHINS Insurance
EMAIL_REPLY_TO=support@phins.ai

# --- SMTP Configuration ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

# --- SendGrid Configuration (if EMAIL_PROVIDER=sendgrid) ---
SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=verified-sender@your-domain.com

# --- AWS SES Configuration (if EMAIL_PROVIDER=ses) ---
AWS_SES_REGION=us-east-1
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY also required
# AWS_SES_FROM_EMAIL=verified-sender@your-domain.com

# --- Mailgun Configuration (if EMAIL_PROVIDER=mailgun) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# MAILGUN_FROM_EMAIL=verified-sender@your-domain.com

# --- Resend Configuration (if EMAIL_PROVIDER=resend) ---
RESEND_API_KEY=
# RESEND_FROM_EMAIL=verified-sender@your-domain.com

# --- Active Notifications / Pingram / NotificationAPI (if EMAIL_PROVIDER=active_notifications) ---
ACTIVE_NOTIFICATIONS_CUSTOMER_ID=
ACTIVE_NOTIFICATIONS_API_KEY=
ACTIVE_NOTIFICATIONS_BASE_URL=https://api.pingram.io
ACTIVE_NOTIFICATIONS_SEND_PATH=/sender
ACTIVE_NOTIFICATIONS_NOTIFICATION_TYPE=phins_transactional_email
# Optional aliases also supported:
# PINGRAM_CLIENT_ID=
# PINGRAM_API_KEY=
# PINGRAM_BASE_URL=https://api.pingram.io

# --- Infobip Configuration (if EMAIL_PROVIDER=infobip; shared with SMS) ---
# API key: https://portal.infobip.com → Developer Tools → API Keys.
# The base URL is account-specific and shown next to the key.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
# INFOBIP_FROM_ADDRESS=verified-sender@your-domain.com

# ============================================================================
# SMS SERVICE (CHOOSE ONE PROVIDER)
# ============================================================================
# Options: infobip, twilio, sns, vonage, messagebird
# IMPORTANT: set SMS_PROVIDER to match the provider you configured below.
# If SMS_PROVIDER cannot deliver (missing credentials/SDK), the app
# auto-selects the first fully-configured provider (Infobip is preferred)
# so SMS verification codes still deliver. Set this explicitly to avoid
# relying on that fallback.
SMS_PROVIDER=infobip

# --- Infobip Configuration (if SMS_PROVIDER=infobip) ---
# Shares INFOBIP_API_KEY + INFOBIP_BASE_URL with the email provider above.
# Sender: a registered number or alphanumeric sender ID (trial accounts can
# use the shared default 'InfoSMS').
# INFOBIP_SMS_SENDER=InfoSMS

# --- Twilio Configuration (if SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890

# --- AWS SNS Configuration (if SMS_PROVIDER=sns) ---
AWS_SNS_REGION=us-east-1

# --- Vonage Configuration (if SMS_PROVIDER=vonage) ---
VONAGE_API_KEY=
VONAGE_API_SECRET=

# --- MessageBird Configuration (if SMS_PROVIDER=messagebird) ---
MESSAGEBIRD_API_KEY=

# NOTE: Telesign support was removed. TELESIGN_* variables are ignored;
# delete them (TELESIGN_CUSTOMER_ID, TELESIGN_API_KEY, etc.) from deployment
# environments. Use SMS_PROVIDER=infobip instead.

# ============================================================================
# OTP CONFIGURATION
# ============================================================================
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_USE_ALPHANUMERIC=false
OTP_REQUIRED_NEW_DEVICE=true
OTP_REQUIRED_NEW_LOCATION=true
OTP_REQUIRED_REGISTRATION=true

# ============================================================================
# CAPTCHA CONFIGURATION
# ============================================================================
CAPTCHA_ENABLED=true
CAPTCHA_TYPE=simple  # Options: simple, hcaptcha, recaptcha

# --- hCaptcha Configuration (if CAPTCHA_TYPE=hcaptcha) ---
HCAPTCHA_SECRET=
HCAPTCHA_SITE_KEY=

# --- reCAPTCHA Configuration (if CAPTCHA_TYPE=recaptcha) ---
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BLOCK_DURATION_MINUTES=30

# OTP rate limits
OTP_RATE_LIMIT_PER_MINUTE=3
OTP_RATE_LIMIT_PER_HOUR=10
OTP_RATE_LIMIT_PER_DAY=20

# Email rate limits
EMAIL_RATE_LIMIT_PER_MINUTE=10
EMAIL_RATE_LIMIT_PER_HOUR=50
EMAIL_RATE_LIMIT_PER_DAY=200

# SMS rate limits
SMS_RATE_LIMIT_PER_MINUTE=5
SMS_RATE_LIMIT_PER_HOUR=20
SMS_RATE_LIMIT_PER_DAY=50

# IP-based limits
IP_RATE_LIMIT_PER_MINUTE=30
IP_RATE_LIMIT_PER_HOUR=200
LOGIN_ATTEMPTS_PER_IP_HOUR=20
OTP_REQUESTS_PER_IP_HOUR=10
CAPTCHA_FAILURES_BEFORE_BLOCK=5
IP_BLOCK_DURATION_MINUTES=30

# ============================================================================
# PAYMENT GATEWAYS (OPTIONAL - for payment processing)
# ============================================================================
# --- Stripe Configuration ---
# Get keys from https://dashboard.stripe.com/apikeys
# Use sk_test_xxx for testing, sk_live_xxx for production
STRIPE_API_KEY=

# --- PayPal Configuration ---
# Get credentials from https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true  # Set to false for production

# ============================================================================
# NOTIFICATION QUEUE
# ============================================================================
NOTIFICATION_QUEUE_ENABLED=true
NOTIFICATION_QUEUE_MAX_RETRIES=3
NOTIFICATION_QUEUE_RETRY_DELAY_SECONDS=60
NOTIFICATION_QUEUE_WORKER_THREADS=5

# ============================================================================
# AUDIT CONFIGURATION
# ============================================================================
NOTIFICATION_AUDIT_ENABLED=true
NOTIFICATION_AUDIT_RETENTION_DAYS=365

# ============================================================================
# SECURITY OPTIONS
# ============================================================================
ENABLE_IP_BLOCKING=true
IP_BLACKLIST=  # Comma-separated list
ENABLE_GEO_RESTRICTIONS=false
ALLOWED_COUNTRIES=  # Comma-separated country codes

# ============================================================================
# TRUSTED DEVICE SETTINGS
# ============================================================================
DEVICE_TRUST_DURATION_DAYS=30
MAX_TRUSTED_DEVICES=5

# ============================================================================
# SESSION CONFIGURATION
# ============================================================================
SESSION_TIMEOUT=1800  # 30 minutes in seconds

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
