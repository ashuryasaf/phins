# =============================================================================
# SECURITY - Sensitive files that should NEVER be committed
# =============================================================================

# Environment files (contain secrets)
.env
.env.local
.env.development
.env.staging
.env.production
.env.*.local

# Credential files
credentials.json
secrets.json
*.credentials
service-account*.json

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa
id_dsa
id_ecdsa
id_ed25519

# AWS credentials
.aws/credentials

# =============================================================================
# Python
# =============================================================================

# Cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.py[cod]

# Virtual environments
venv/
.venv/
ENV/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# =============================================================================
# Database
# =============================================================================

# Database files
*.db
*.sqlite
*.sqlite3
phins.db

# Database dumps (may contain sensitive data)
*.sql
*.dump
!schema.sql

# =============================================================================
# Backups (never commit)
# =============================================================================
# Platform snapshots aggregate the entire deployment and may include a database
# dump. Committing them publishes that payload permanently in git history and to
# every clone/fork. scripts/backup_platform.sh refuses to write anywhere git
# would track, so this entry is what keeps the default destination usable.
backups/
# Forensic snapshots written before a ledger chain repair (live ledger data).
phins_ledger_chain_backup_*.json

# =============================================================================
# IDE and Editor
# =============================================================================

# JetBrains IDEs
.idea/

# VS Code (optional, uncomment if needed)
# .vscode/

# Vim
*.swp
*.swo
*~

